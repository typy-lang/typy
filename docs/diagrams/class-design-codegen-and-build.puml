@startuml class-design-codegen-and-build
!include style.puml
title Design classes of typy_codegen and typy_build
hide empty members
skinparam nodesep 25

package "typy_codegen" as CodegenCrate {
    class "object()" as GenerateObject <<function>> {
        {field} +object(module, target, options, lookup) : Result<ObjectFile>
    }
    class CodegenOptions <<struct>> {
        +optimization : Optimization
        +processor : Option<String>
        +features : String
    }
    class Target <<struct>> {
        +triple : TargetTriple
    }
    class ObjectFile <<struct>> {
        +target : Target
        +bytes : Vec<u8>
    }
}

package "typy_build" as BuildCrate {
    class BuildRequest <<struct>> {
        +main : MainSource
        +mode : BuildMode
        +target : Target
        +emit : Option<EmitStage>
        +output : Option<Utf8PathBuf>
        +library : Option<LibraryKind>
        +processor : Option<String>
        +features : String
        {field} +codegen_options() : CodegenOptions
    }
    class BuildMode <<struct>> {
        +optimization : Optimization
        {field} +DEBUG, RELEASE, RELEASE_SMALL
    }
    class Linker <<struct>> {
        {field} +link(object, output) : Result<Artifact>
    }
    class Artifact <<struct>> {
        +path : Utf8PathBuf
        +kind : ArtifactKind
    }
}

class "typy_tyir::TyirModule" as TyirModule <<struct>>
class "typy_source::MainSource" as MainSource <<enum>>

GenerateObject ..> TyirModule : reads
GenerateObject ..> CodegenOptions : reads
GenerateObject ..> ObjectFile : writes
ObjectFile --> Target
BuildRequest --> MainSource
BuildRequest --> BuildMode
BuildRequest --> Target
BuildRequest ..> CodegenOptions : gives
Linker ..> ObjectFile : reads
Linker ..> Artifact : writes
' The classes of other crates go below the rest, so the diagram stays narrow.
Target -[hidden]down- TyirModule
BuildMode -[hidden]down- MainSource
@enduml
