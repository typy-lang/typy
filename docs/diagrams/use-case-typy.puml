@startuml use-case-typy
!include style.puml
title TyPy use cases and their actors
left to right direction
skinparam nodesep 18
skinparam ranksep 70

actor "Application developer" as Developer
actor "Library binder" as Binder
actor "Tool integrator" as Integrator
actor "Compiler contributor" as Contributor

rectangle "TyPy" {
    usecase "UC-11 Configure a project" as UC11
    usecase "UC-04 Read the explanation\nof a diagnostic" as UC04
    usecase "UC-03 Run a program" as UC03
    usecase "UC-02 Build an executable" as UC02
    usecase "UC-01 Check a program" as UC01
    usecase "UC-08 Cross-compile\nfor another target" as UC08
    usecase "UC-06 Call a C library" as UC06
    usecase "UC-07 Export functions to C" as UC07
    usecase "UC-10 Read diagnostics\nin an editor or CI" as UC10
    usecase "UC-05 Inspect a compiler stage" as UC05
    usecase "UC-09 Verify conformance\nagainst CPython" as UC09
}

actor "C toolchain" as Toolchain <<system>>
actor "C library" as CLibrary <<system>>
actor "CPython oracle" as Oracle <<system>>

Developer --> UC11
Developer --> UC04
Developer --> UC03
Developer --> UC02
Developer --> UC01
Developer --> UC08
Binder --> UC06
Binder --> UC07
Integrator --> UC10
Contributor --> UC05
Contributor --> UC09

Developer <|-- Binder

UC02 --> Toolchain
UC06 --> CLibrary
UC09 --> Oracle
@enduml
