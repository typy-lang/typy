@startuml class-design-runtime
!include style.puml
title Design classes of the runtime
hide empty members
skinparam nodesep 25

package "typy_runtime" as RuntimeCrate {
    class ObjectHeader <<repr(C)>> {
        +reference_count : u32
        +type_id : u32
    }
    class TypeObject <<repr(C)>> {
        +header : ObjectHeader
        +name : *const u8
        +base : *const TypeObject
        +truth, hash, equal, order, repr : Option<fn>
        +module : *const u8
        +fields : *const TupleType
        +str : Option<fn>
    }
    class InstanceObject <<repr(C)>> {
        +header : ObjectHeader
        +class : *const TypeObject
        +attributes : [u64]
    }
    class Int <<repr(transparent)>> {
        +word : u64
    }
    class BigInt <<repr(C)>> {
        +header : ObjectHeader
        +sign_and_length : i32
        +limbs : [u64]
    }
    class Str <<repr(C)>> {
        +header : ObjectHeader
        +length : u64
        +kind : StrKind
        +data : [u8]
    }
    class ExceptionObject <<repr(C)>> {
        +header : ObjectHeader
        +class : *const TypeObject
        +message : *mut Str
        +arguments_type : *const TupleType
        +arguments : *mut u8
        +traceback : TracebackBuffer
        +cause, context : *mut ExceptionObject
        +suppress_context : u64
        +attributes : [u64]
    }
    class TracebackEntry <<repr(C)>> {
        +function : *const u8
        +file : *const u8
        +line : u32
    }
    class Allocator <<struct>> {
        {field} +allocate(size) : *mut u8
        {field} +reallocate(*mut u8, size) : *mut u8
        {field} +free(*mut u8)
    }
}

BigInt *-- ObjectHeader
Str *-- ObjectHeader
ExceptionObject *-- ObjectHeader
ExceptionObject *-- TracebackEntry
InstanceObject *-- ObjectHeader
TypeObject *-- ObjectHeader
TypeObject --> TypeObject : base, up to object
InstanceObject --> TypeObject : class
ExceptionObject --> TypeObject : class, an exception class
ObjectHeader ..> TypeObject : type_id finds
Int ..> BigInt : points to when not inline
Allocator ..> ObjectHeader : allocates objects that start with
@enduml
